{
  "info": {
    "name": "FimpleCaseStudy - Infrastructure",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "v1.0.0 altyapı kontrolleri. Uçtan uca ATM akışı EndToEnd collection içindedir."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "API info",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/info"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response contract\", () => { pm.expect(pm.response.json().version).to.eql(\"1.0.0\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response contract\", () => { pm.expect(pm.response.json().status).to.eql(\"Healthy\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/live"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response contract\", () => { pm.expect(pm.response.text()).to.eql(\"Healthy\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown route",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/does-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Response contract\", () => { pm.expect(pm.response.json().code).to.eql(\"RESOURCE_NOT_FOUND\"); });"
            ]
          }
        }
      ]
    }
  ]
}
