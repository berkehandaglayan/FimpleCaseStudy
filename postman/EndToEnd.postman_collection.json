          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes"
