    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"alerts ok\", () => pm.response.to.have.status(200));",
              "pm.test(\"initial service and threshold events\", () => { const a=pm.response.json();pm.expect(a.length).to.eql(4);pm.expect(a.filter(e=>e.reason===\"INITIAL_SERVICE_LOW_CASH\").length).to.eql(1);pm.expect(a.filter(e=>e.reason===\"AVAILABLE_COUNT_FELL_BELOW_THRESHOLD\").length).to.eql(3); });",
              "pm.test(\"recycling only and valid threshold\", () => pm.expect(pm.response.json().every(e=>e.slot<5&&e.available<10&&e.threshold===10)).to.eql(true));"
            ],
            "type": "text/javascript"
          }
