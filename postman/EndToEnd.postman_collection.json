  "variable": [
    {
      "value": "http://localhost:8080",
      "key": "baseUrl"
    }
  ],
  "info": {
    "name": "FimpleCaseStudy - End-to-end cash management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ordered full cash scenario, four-eyes approval, snapshot FX and overall TRY reporting, plus committed low-cash alerts. Worker delivery/retry/concurrency are tested against real PostgreSQL. Seed FX is demonstration data."
  }
}
