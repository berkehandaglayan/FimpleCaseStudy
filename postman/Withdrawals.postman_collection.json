{
  "variable": [
    {
      "value": "http://localhost:8080",
      "key": "baseUrl"
    }
  ],
  "item": [
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"created\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"atmId\", pm.response.json().id);",
              "pm.collectionVariables.set(\"confirmKey\", \"postman-\" + pm.response.json().id);",
              "pm.test(\"five cassettes\", () => pm.expect(pm.response.json().cassettes.length).to.eql(5));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"name\":\"Postman withdrawal ATM\"}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms"
      },
      "name": "Create ATM"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"configured\", () => pm.response.to.have.status(200));",
              "pm.test(\"state\", () => pm.expect(pm.response.json().state).to.eql(\"CONFIGURED\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"cassettes\":[{\"slot\":1,\"currency\":\"TRY\",\"denomination\":100},{\"slot\":2,\"currency\":\"TRY\",\"denomination\":50},{\"slot\":3,\"currency\":\"TRY\",\"denomination\":20},{\"slot\":4,\"currency\":\"USD\",\"denomination\":100}]}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "PUT",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/configuration"
      },
      "name": "Configure cassettes"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"loaded\", () => pm.response.to.have.status(200));",
              "pm.test(\"state\", () => pm.expect(pm.response.json().state).to.eql(\"LOADED\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"lines\":[{\"slot\":1,\"currency\":\"TRY\",\"denomination\":100,\"count\":10},{\"slot\":3,\"currency\":\"TRY\",\"denomination\":20,\"count\":10},{\"slot\":4,\"currency\":\"USD\",\"denomination\":100,\"count\":10}]}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/load"
      },
      "name": "Load cash"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"in service\", () => pm.response.to.have.status(200));",
              "pm.test(\"state\", () => pm.expect(pm.response.json().state).to.eql(\"IN_SERVICE\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"state\":\"IN_SERVICE\"}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/state"
      },
      "name": "In service"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"quote created\", () => pm.response.to.have.status(201));",
              "const q = pm.response.json(); pm.collectionVariables.set(\"quoteId\", q.id);",
              "pm.test(\"60 seconds\", () => pm.expect(new Date(q.expiresAt)-new Date(q.createdAt)).to.eql(60000));",
              "pm.test(\"alternatives\", () => pm.expect(q.options.map(x => x.plan.amount)).to.eql([120,140]));",
              "pm.test(\"open\", () => pm.expect(q.status).to.eql(\"OPEN\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"cardNumber\":\"9900000000000050\",\"currency\":\"TRY\",\"amount\":130}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes"
      },
      "name": "Quote alternatives"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"ok\", () => pm.response.to.have.status(200));",
              "pm.test(\"physical unchanged and per-cassette maximum\", () => { const c=pm.response.json().cassettes; pm.expect(c.find(x=>x.slot===1).reserved).to.eql(1); pm.expect(c.find(x=>x.slot===3).reserved).to.eql(2); pm.expect(c.find(x=>x.slot===1).onHand).to.eql(10); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "GET",
        "url": "{{baseUrl}}/api/atms/{{atmId}}"
      },
      "name": "Inspect reservation"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"confirmed\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"confirmBody\", pm.response.text());",
              "pm.test(\"selected lower\", () => { pm.expect(pm.response.json().selectedOption).to.eql(\"lower\"); pm.expect(pm.response.json().status).to.eql(\"CONFIRMED\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"option\":\"lower\"}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          },
          {
            "value": "{{confirmKey}}",
            "key": "Idempotency-Key"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{quoteId}}/confirm"
      },
      "name": "Confirm lower"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"replayed\", () => pm.response.to.have.status(200));",
              "pm.test(\"identical response bytes\", () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get(\"confirmBody\")));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"option\":\"lower\"}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          },
          {
            "value": "{{confirmKey}}",
            "key": "Idempotency-Key"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{quoteId}}/confirm"
      },
      "name": "Replay confirmation"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"conflict\", () => pm.response.to.have.status(409));",
              "pm.test(\"idempotency conflict\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_CONFLICT\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"option\":\"upper\"}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          },
          {
            "value": "{{confirmKey}}",
            "key": "Idempotency-Key"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{quoteId}}/confirm"
      },
      "name": "Different body same key"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"quote created\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"cancelQuoteId\", pm.response.json().id);",
              "pm.test(\"exact\", () => pm.expect(pm.response.json().options[0].name).to.eql(\"exact\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"cardNumber\":\"9900000000000050\",\"currency\":\"TRY\",\"amount\":100}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes"
      },
      "name": "New quote for cancellation"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"cancelled\", () => pm.response.to.have.status(200));",
              "pm.test(\"status\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{cancelQuoteId}}/cancel"
      },
      "name": "Cancel quote"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"created\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"maintenanceQuoteId\", pm.response.json().id);",
              "pm.test(\"open\", () => pm.expect(pm.response.json().status).to.eql(\"OPEN\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"cardNumber\":\"9900000000000050\",\"currency\":\"TRY\",\"amount\":100}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes"
      },
      "name": "Quote before maintenance"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"maintenance\", () => pm.response.to.have.status(200));",
              "pm.test(\"no reservations\", () => pm.expect(pm.response.json().cassettes.every(x=>x.reserved===0)).to.eql(true));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "body": {
          "raw": "{\"state\":\"MAINTENANCE\"}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/state"
      },
      "name": "Maintenance cancels open quote"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"ok\", () => pm.response.to.have.status(200));",
              "pm.test(\"cancelled\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "GET",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes/{{maintenanceQuoteId}}"
      },
      "name": "Inspect cancelled quote"
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"ok\", () => pm.response.to.have.status(200));",
              "pm.test(\"single withdrawal and all releases\", () => { const c=pm.response.json().cassettes; pm.expect(c.find(x=>x.slot===1).onHand).to.eql(9); pm.expect(c.find(x=>x.slot===3).onHand).to.eql(9); pm.expect(c.every(x=>x.reserved===0)).to.eql(true); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "GET",
        "url": "{{baseUrl}}/api/atms/{{atmId}}"
      },
      "name": "Inspect final cash"
    }
  ],
  "info": {
    "description": "v0.5.0: alternatives, reservation, confirm, persisted replay, key conflict, cancel and maintenance. Synthetic card only. Expiry/concurrency/restart are verified by real PostgreSQL integration tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "FimpleCaseStudy - Withdrawals"
  }
}
